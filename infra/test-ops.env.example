# The test-ops installation's settings (docs/operator/test-ops.md). Install a copy
# outside the checkout, readable by the operator alone:
#
#   sudo install -m 600 -o "$USER" infra/test-ops.env.example /etc/werft/test-ops.env
#
# scripts/test-ops.sh hands the file to compose with --env-file and never
# sources it; compose reads KEY=value lines. Every value compose.test-ops.yml
# requires is below and left empty, so a forgotten one stops compose. Use
# letters, digits and . _ ~ - only: the postgres values go into a URL
# unescaped, and the preflight refuses anything else there.
#
# The object store is chosen at deploy by TEST_OPS_OBJECT_STORE, not here:
# localstack (the default) needs nothing below; s3 needs the block at the end.

# Two installations on one daemon need different ids; `local` is the local stack's.
EXECUTION_INSTALLATION_ID=test-ops

POSTGRES_PASSWORD=
# The API and the egress proxy share it; 32 or more random characters.
EGRESS_AUTHORIZER_TOKEN=

# Optional. The model key is normally entered on the web console's model
# connections screen and sealed in the database. Fill this only for a
# connection the settings document names with `value_env: ANTHROPIC_API_KEY`.
ANTHROPIC_API_KEY=

# The token that creates the web console's first owner (POST /v1/auth/bootstrap),
# 32 to 256 characters. Left commented out (the default), the API generates one
# and `scripts/test-ops.sh bootstrap-token` shows it once after deploy; it
# never reaches the container log. Do not uncomment it empty: the API refuses
# to start.
# BOOTSTRAP_TOKEN=

# The master key stored credentials are encrypted under
# (`openssl rand -hex 32`). The API refuses to start without it.
PLATFORM_SECRET_KEY=

# The settings document migrate imports, outside the checkout; the release
# manifest names its digest.
PLATFORM_SETTINGS_DOCUMENT=/etc/werft/settings.json
# The old catalog directory, for the one upgrade that imports it
# (docs/operator/test-ops.md).
# PLATFORM_LEGACY_CONFIG_DIR=/etc/werft/catalog

# Credential routes: the provider, the catalog's git host and the object
# store — on localstack localstack:4566 here; on s3 the bucket's S3 host
# (<bucket>.s3.<region>.amazonaws.com:443) in the first list instead, and no
# second list.
EGRESS_CREDENTIAL_ALLOWLIST=api.anthropic.com:443,api.openai.com:443,github.com:443
EGRESS_CREDENTIAL_PRIVATE_ALLOWLIST=localstack:4566

# Worker workspace quota on xfs with prjquota; the scheduler probes it at startup.
EXECUTION_WORKSPACE_QUOTA=on

# Installation limits and the rest of compose.core.yml's settings keep
# their defaults unless set here, e.g.:
# EXECUTION_SLOT_LIMIT=10
# SESSION_COST_LIMIT_USD=25
# Provider tokens per session, whatever they cost; 0 is no limit.
# SESSION_TOKEN_LIMIT=0

# Host ports, on loopback only, when the defaults are taken. The API URL is
# where scripts/test-ops.sh checks /readyz; it follows TEST_OPS_API_PORT, so
# set it only for a proxy in front of the installation.
# TEST_OPS_API_PORT=3000
# TEST_OPS_POSTGRES_PORT=5432
# TEST_OPS_API_URL=http://127.0.0.1:3000

# TEST_OPS_OBJECT_STORE=s3 only: the bucket (Tokyo, versioning + Object Lock
# + SSE-S3) and the API's IAM key.
# AWS_REGION=ap-northeast-1
# S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
