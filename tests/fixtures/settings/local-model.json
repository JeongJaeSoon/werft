{
  "version": 1,
  "connections": {
    "ollama": {
      "kind": "anthropic",
      "endpoint": "http://ollama.internal:11434",
      "auth": {
        "kind": "api_key",
        "value_env": "LOCAL_OLLAMA_API_KEY"
      },
      "models": [
        "gemma4:26b-mlx"
      ]
    },
    "litellm": {
      "kind": "litellm",
      "endpoint": "http://litellm:4000",
      "auth": {
        "kind": "bearer",
        "value_env": "LITELLM_MASTER_KEY"
      },
      "models": [
        "gemma4-local"
      ]
    }
  },
  "repositories": {
    "sample-app": {
      "url": "http://fake-git:3000/agent/sample-app.git",
      "branch": "main",
      "auth": {
        "kind": "github_app",
        "app_id": 1,
        "installation_id": 1,
        "api_base": "http://fake-git:3000",
        "secret_id": "werft/local/fake-github-app"
      }
    }
  },
  "mcp_servers": {}
}
