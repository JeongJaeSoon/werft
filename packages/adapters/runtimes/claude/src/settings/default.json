{
  "secretNameParts": [
    ".env",
    ".npmrc",
    ".yarnrc",
    ".pypirc",
    ".netrc",
    ".pem",
    ".key",
    ".p12",
    ".pfx",
    ".keystore",
    "id_rsa",
    "id_ecdsa",
    "id_ed25519",
    "credentials",
    "service-account"
  ],
  "sensitiveEditPaths": [
    ".git/**",
    ".claude/**",
    ".mcp.json",
    ".aws/**",
    ".ssh/**",
    ".docker/**",
    ".kube/**",
    "**/.env",
    "**/.env.*",
    "**/.npmrc",
    "**/.yarnrc.yml",
    "**/.pypirc",
    "**/.netrc",
    "**/*.pem",
    "**/*.key",
    "**/*.p12",
    "**/*.pfx",
    "**/*.keystore",
    "**/id_rsa*",
    "**/id_ecdsa*",
    "**/id_ed25519*",
    "**/credentials*",
    "**/service-account*.json"
  ],
  "git": {
    "allow": ["git", "gh"],
    "ask": [
      "git * --output*",
      "git * --ext-diff*",
      "git -C *",
      "git --* -C *",
      "git --git-dir*",
      "git * --git-dir*",
      "git --work-tree*",
      "git * --work-tree*",
      "git -c *",
      "git --* -c *",
      "git * --file*",
      "git * --global*",
      "git * --system*",
      "git * --no-index*",
      "git config alias.*",
      "git config * alias.*",
      "git add -*f*",
      "git add * -*f*",
      "git add --force*",
      "git add * --force*",
      "git * add -*f*",
      "git * add * -*f*",
      "git * add --force*",
      "git * add * --force*",
      "gh auth *",
      "gh alias *",
      "gh extension *",
      "gh api *@*",
      "gh api * --input*"
    ],
    "askWhenSecretNamed": ["git add", "git commit"]
  },
  "read": {
    "allow": ["sed"],
    "ask": [
      "sed -i*",
      "sed * -i*",
      "sed --in-place*",
      "sed * --in-place*",
      "sed -ni*",
      "sed * -ni*",
      "sed -si*",
      "sed * -si*",
      "sed -Ei*",
      "sed * -Ei*",
      "sed -ri*",
      "sed * -ri*",
      "sed -zi*",
      "sed * -zi*",
      "sed -ui*",
      "sed * -ui*",
      "sed *w *"
    ]
  },
  "fs": {
    "allow": ["mkdir"],
    "ask": [
      "mkdir /*",
      "mkdir * /*",
      "mkdir *..*",
      "mkdir ~*",
      "mkdir * ~*",
      "mkdir *$*",
      "mkdir *`*"
    ]
  },
  "secretRead": {
    "readers": ["cat", "head", "tail", "grep", "rg", "sed"],
    "nameStarts": [" ", "/", "\"", "'", "=", "-f"],
    "clusterLetters": "nHiswNlcoF",
    "extensions": [".pem", ".key", ".p12", ".pfx", ".keystore"],
    "extensionEnds": [" ", "\"", "'"],
    "notAReadName": ["credentials", "service-account"],
    "extraNames": ["service-account*.json", ".git/config"]
  },
  "rgHidden": {
    "ask": [
      "rg *--hidden*",
      "rg *--no-ignore*",
      "rg *--unrestricted*",
      "rg -u*",
      "rg * -u*"
    ],
    "letterBeforeUU": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"
  },
  "dev": {
    "commands": [
      "bun test",
      "bun run",
      "npm test",
      "npm run",
      "pnpm test",
      "pnpm run",
      "yarn test",
      "yarn run"
    ],
    "ask": [
      "* --prefix*",
      "* --script-shell*",
      "* --cwd*",
      "* -C *",
      "* /*",
      "* ..*",
      "* */../*"
    ]
  }
}
