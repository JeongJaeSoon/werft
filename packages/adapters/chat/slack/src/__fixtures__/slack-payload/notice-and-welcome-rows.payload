{
  "every-notice-copy": {
    "en": {
      "agentOwnerless": "No one administers this agent, so it can't start a new session. Ask a workspace admin to assign an agent admin",
      "botTurnLimit": "Bots went back and forth 5 times with no person in between, so this stops here. A person needs to take it from here",
      "budgetAccountTeam": "The agent team's monthly budget limit was reached, so the model could not be called. It lifts on the 1st of next month (UTC), or sooner when a workspace admin raises the limit",
      "budgetAccountUser": "The requester's monthly budget limit was reached, so the model could not be called. It lifts on the 1st of next month (UTC), or sooner when a workspace admin raises the limit",
      "callerLimitedCredential": "A limit set on the people who use this agent doesn't allow this agent's credential settings",
      "callerLimitedMcpServer": "A limit set on the people who use this agent doesn't allow this session's MCP server",
      "callerLimitedRepository": "A limit set on the people who use this agent doesn't allow starting with this repository",
      "callerLimitedTool": "A limit set on the people who use this agent doesn't allow a tool this session uses",
      "capacityWait": "Waiting for room to run this. It starts as soon as room frees up",
      "codexSandboxNotInstalled": "This agent's runtime (the Codex sandbox) is not installed here. Tell an administrator",
      "connect": "Link your Slack account on the web",
      "credentialUnbound": "The connection settings changed, so the agent couldn't start. Contact the agent's admin",
      "failed": "We couldn't process the request right now. Try again shortly",
      "guestDisabled": "This workspace doesn't allow guests to use agents",
      "membersOnly": "Only members of this workspace can use this agent",
      "noActiveRelease": "This agent is not published yet. Try it in the web console and publish it to use it in Slack",
      "noApproveRight": "You don't have permission to approve this request",
      "noCapacity": "There was no room to start this right now. Please ask again in a little while",
      "noCapacityPaused": "There was no room to resume this. The session stays paused; please resume it again in a little while",
      "noRequestRight": "You don't have permission to make requests to this agent in this channel",
      "nothingToStop": "There's no task running right now.",
      "outOfShare": "This session isn't shared with you, so you can't make requests in it. Ask the person who started the session to share it",
      "ownershipLost": "The work was cut off partway. The connection to the server dropped for a moment. What it did after the last save point needs checking.",
      "ownershipLostContinue": "Continue",
      "ownershipLostContinued": "Continuing from the last save point",
      "pendingApproval": "This channel is waiting for an admin's approval",
      "releaseUnavailable": "The agent couldn't start because its release's connection was disabled or its model left the connection's list. An agent admin needs to create and activate a new release on an available connection and model in the web console",
      "repositoryRequired": "The agent couldn't start because its release has no repository it can use (none was chosen, it was removed from the catalog, or the workspace ceiling does not allow it) or its GitHub settings can't be read. An agent admin needs to check the GitHub settings in the web console and, if a repository is needed, choose one, then create and activate a new release",
      "routeConnect": "To hand this to the task, link your Slack account in the web console.",
      "routeFailed": "This couldn't be handed to the task.",
      "routeMirror": "Continuing in the original thread ↗",
      "routeNoRight": "This request doesn't have permission to add to that task",
      "sessionStopped": "Stopped the task as you asked. Write in this thread again to carry on.",
      "sessionStoppedQueued": "Stopped the task as you asked. {count} waiting messages were not processed either. Write in this thread again to carry on.",
      "startFresh": "The work was cut off partway. This conversation has no save point yet.",
      "startFreshContinue": "Continue in a new context",
      "startFreshContinued": "Running the same request again in a new context",
      "startFreshWarning": "The same request runs again from the start, without the earlier conversation's context. What it did before it was cut off needs checking.",
      "stopNotPermitted": "Only the person who asked for this task can stop it",
      "storageLimit": "This installation's storage limit has too little room left, so this request was not taken. Ask an administrator to raise the limit",
      "taskChannel": "Tasks can't be started in this channel",
      "taskConnect": "To start a task, link your Slack account in the web console.",
      "taskFailed": "The task couldn't be started.",
      "taskLimitAgent": "This agent already has 10 open tasks, so a new one wasn't started. Ask again once one of them finishes",
      "taskLimitConversation": "This conversation already has 3 open tasks, so a new one wasn't started. Ask again once one of them finishes",
      "taskNoRight": "This request doesn't have permission to start a task",
      "taskRepository": "The chosen repository isn't one this agent can use, so the task wasn't started"
