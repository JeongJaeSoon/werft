  {
    "_meta": {
      "class": "repository.read",
    },
    "description": "List the repositories this session works with, 100 a page (\`limit\` 1 to 500): the one named when the session was created, and those the agent's settings allow it to attach. Listing fetches nothing and changes nothing. \`status\` is \`attached\` (the platform lists it as added to the session; \`remote\` is the git remote name it was given, \`origin\` for the repository named when the session was created), \`pending\` or \`failed\` (its fetch is running, or ended with an error), \`not_attached\` (allowed, not added yet) or \`allowed_in_newer_release\` (only the agent's current release allows it). \`next_cursor\` is non-null when more follow: send it back as \`cursor\`. \`query\` keeps those whose id or name contains it. Each repository's \`meaning\` is its status in plain words.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "maxLength": 256,
          "minLength": 1,
          "type": "string",
        },
        "limit": {
          "maximum": 500,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "list_repositories",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true,
              "type": "boolean",
            },
            "result": {
              "additionalProperties": false,
              "properties": {
                "next_cursor": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "repositories": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "branch": {
                        "type": [
                          "string",
                          "null",
                        ],
                      },
                      "id": {
                        "minLength": 1,
                        "type": "string",
                      },
                      "meaning": {
                        "type": "string",
                      },
                      "name": {
                        "type": "string",
                      },
                      "remote": {
                        "minLength": 1,
                        "type": "string",
                      },
                      "status": {
                        "enum": [
                          "primary",
                          "attached",
                          "pending",
                          "failed",
                          "available",
                          "allowed_in_newer_release",
                          "not_attached",
                          "revoked",
                        ],
                        "type": "string",
                      },
                    },
                    "required": [
                      "id",
                      "name",
                      "branch",
                      "status",
                    ],
                    "type": "object",
                  },
                  "type": "array",
                },
              },
              "required": [
                "repositories",
                "next_cursor",
              ],
              "type": "object",
            },
          },
          "required": [
            "ok",
            "result",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false,
              "type": "boolean",
            },
            "refusal": {
              "additionalProperties": false,
              "properties": {
                "by": {
                  "enum": [
                    "policy",
                    "person",
                    "platform",
                    "github",
                  ],
                  "type": "string",
                },
                "code": {
                  "pattern": "^[a-z][a-z0-9_]{1,63}$",
                  "type": "string",
                },
                "details": {
                  "additionalProperties": {},
                  "propertyNames": {
                    "type": "string",
                  },
                  "type": "object",
                },
                "retryable": {
                  "type": "boolean",
                },
              },
              "required": [
                "code",
                "by",
                "retryable",
              ],
              "type": "object",
            },
          },
          "required": [
            "ok",
            "refusal",
          ],
          "type": "object",
        },
      ],
      "type": "object",
    },
  },
  {
    "_meta": {
      "class": "repository.read",
    },
    "description": "Attach one allowed repository to the session as a git remote named \`repository_id\`, with its default branch fetched to \`<repository_id>/<branch>\`. A session has no repository in its workspace until one is attached (or was named when the session was created). A new attach is recorded on the session; a repository already attached, or the session's own, is answered as attached with nothing new recorded. It is meant for a repository whose code the task reads or changes; allowed repositories the task does not touch stay unattached, and \`list_repositories\` needs no attach. \`status\` is \`pending\` while the fetch runs. \`wait_seconds\` (0 to 7, default 0) holds the answer until the fetch ends or the seconds have passed; \`final\` is false when the fetch was still running at the end of the wait. Attaching an attached repository changes nothing, so a repeat with the same arguments is safe. A failure that comes from the connection (an \`upstream connection failed\` answer, or HTTP 502 or 503) is transient and says nothing about the repository; \`repository_not_allowed\` is a refusal by the agent's settings, not a connection failure. Commit changes to it on a local branch started from \`<repository_id>/<branch>\` in the workspace (a git worktree or clone elsewhere is not saved), then push that branch with \`request_push\`, naming \`repository_id\` and \`source_ref\`.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "repository_id": {
          "maxLength": 128,
          "minLength": 1,
          "type": "string",
        },
        "wait_seconds": {
          "maximum": 7,
          "minimum": 0,
          "type": "integer",
        },
      },
      "required": [
        "repository_id",
      ],
      "type": "object",
    },
    "name": "attach_repository",
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": true,
              "type": "boolean",
            },
            "result": {
              "additionalProperties": false,
              "properties": {
                "already_attached": {
                  "type": "boolean",
                },
                "branch": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "commit": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "failure": {
                  "anyOf": [
                    {
                      "enum": [
                        "fetch_timeout",
                        "fetch_too_large",
                        "fetch_failed",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "final": {
                  "type": "boolean",
                },
                "receipt_id": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "repository_id": {
                  "minLength": 1,
                  "type": "string",
                },
                "status": {
                  "enum": [
                    "pending",
                    "attached",
                    "failed",
                  ],
                  "type": "string",
                },
              },
              "required": [
                "repository_id",
                "status",
                "branch",
                "commit",
                "failure",
                "already_attached",
                "receipt_id",
                "final",
              ],
              "type": "object",
            },
          },
          "required": [
            "ok",
            "result",
          ],
          "type": "object",
        },
        {
          "additionalProperties": false,
          "properties": {
            "ok": {
              "const": false,
              "type": "boolean",
            },
            "refusal": {
              "additionalProperties": false,
              "properties": {
                "by": {
                  "enum": [
                    "policy",
                    "person",
                    "platform",
                    "github",
                  ],
                  "type": "string",
                },
                "code": {
                  "pattern": "^[a-z][a-z0-9_]{1,63}$",
                  "type": "string",
                },
                "details": {
                  "additionalProperties": {},
                  "propertyNames": {
                    "type": "string",
                  },
                  "type": "object",
                },
                "retryable": {
                  "type": "boolean",
                },
              },
              "required": [
                "code",
                "by",
                "retryable",
              ],
              "type": "object",
            },
          },
          "required": [
            "ok",
            "refusal",
          ],
          "type": "object",
        },
      ],
      "type": "object",
    },
  },
]
`;
