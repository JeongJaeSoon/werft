                          "maximum": 9007199254740991,
                          "minimum": -9007199254740991,
                          "type": "integer",
                        },
                        "url": {
                          "type": "string",
                        },
                      },
                      "required": [
                        "number",
                        "url",
                      ],
                      "type": "object",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "pull_request_error": {
                  "type": [
                    "string",
                    "null",
                  ],
                },
                "pull_request_scheduled": {
                  "type": "boolean",
                },
                "pull_request_stage": {
                  "anyOf": [
                    {
                      "enum": [
                        "due",
