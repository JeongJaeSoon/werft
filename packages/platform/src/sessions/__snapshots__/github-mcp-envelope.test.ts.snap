  {
    "_meta": {
      "class": "pull_request.write",
    },
    "description": "Set the title or the content of the pull request that the push request's branch has open. Given any of \`summary\`, \`changes\`, \`rationale\`, \`testing\`, \`notes\` or \`related\`, the body is written again from those fields (a field left out is empty); \`body\` (legacy) replaces the body as text; \`title\` alone leaves the body. The platform's closing lines stay, naming the push request's commit.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
