                        "turn_finalized_without_pin",
                        "superseded_by_turn",
                        "session_closed",
                        "rejected_before",
                        "request_open",
                        "github_disabled",
                        "over_workspace_ceiling",
                        "repository_not_allowed",
                        "checkpoint_unavailable",
                        "source_missing",
                        "attribution_mismatch",
                        "uncommitted_changes",
                        "pinned_source_invalid",
                      ],
                      "type": "string",
                    },
                    {
                      "type": "null",
                    },
                  ],
                },
                "intent_status": {
                  "anyOf": [
                    {
                      "enum": [
