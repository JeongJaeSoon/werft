                "type": "boolean",
              },
              "number": {
                "exclusiveMinimum": 0,
                "maximum": 9007199254740991,
                "type": "integer",
              },
              "repository_id": {
                "maxLength": 128,
                "minLength": 1,
                "type": "string",
              },
            },
            "required": [
              "number",
            ],
            "type": "object",
          },
          "maxItems": 20,
          "type": "array",
        },
        "summary": {
          "maxLength": 8000,
          "type": "string",
        },
        "testing": {
          "maxLength": 8000,
          "type": "string",
        },
        "title": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "push_request_id",
      ],
      "type": "object",
    },
