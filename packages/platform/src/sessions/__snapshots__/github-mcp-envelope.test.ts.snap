          "items": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 50,
          "type": "array",
        },
        "notes": {
          "maxLength": 8000,
          "type": "string",
        },
        "push_request_id": {
          "format": "uuid",
