{
  "every-notice-copy": {
    "en": {
      "connect": "Link your Slack account on the web",
      "credentialUnbound": "The connection settings changed, so the agent couldn't start. Contact the agent's admin",
      "failed": "We couldn't process the request right now. Try again shortly",
      "guestDisabled": "This workspace doesn't allow guests to use agents",
      "membersOnly": "Only members of this workspace can use this agent",
      "noActiveRelease": "This agent has no active release yet. An agent admin needs to activate a release in the web console",
      "noApproveRight": "You don't have permission to approve this request",
      "noRequestRight": "You don't have permission to make requests to this agent in this channel",
      "outOfShare": "This session isn't shared with you, so you can't make requests in it. Ask the person who started the session to share it",
      "pendingApproval": "This channel is waiting for an admin's approval",
      "profileUnavailable": "The agent couldn't start because its release's profile is missing from the catalog, has changed, or was blocked by an operator. An agent admin needs to create and activate a new release with an available profile in the web console",
      "repositoryRequired": "The agent couldn't start because its release has no repository it can use (none was chosen, it was removed from the catalog, or the profile or workspace ceiling does not allow it) or its GitHub settings can't be read. An agent admin needs to check the GitHub settings in the web console and, if a repository is needed, choose one, then create and activate a new release"
    },
    "ja": {
      "connect": "WebでSlackアカウントを連携してください",
      "credentialUnbound": "接続設定が変更されたため、開始できませんでした。エージェントの管理者にお問い合わせください",
      "failed": "現在リクエストを処理できませんでした。しばらくしてからもう一度お試しください",
      "guestDisabled": "このワークスペースでは、ゲストによるエージェントの利用が許可されていません",
      "membersOnly": "このエージェントはこのワークスペースのメンバーのみ利用できます",
      "noActiveRelease": "このエージェントにはまだ有効なリリースがありません。エージェントの管理者がWebコンソールでリリースを有効化する必要があります",
      "noApproveRight": "このリクエストを承認する権限がありません",
      "noRequestRight": "このチャンネルでこのエージェントにリクエストする権限がありません",
      "outOfShare": "このセッションは共有範囲外のため、リクエストできません。セッションを開始した人に共有を依頼してください",
      "pendingApproval": "このチャンネルは管理者の承認を待っています",
      "profileUnavailable": "このエージェントのリリースが使うプロファイルが、カタログにないか、変更されたか、運用担当者によってブロックされたため、開始できませんでした。エージェントの管理者がWebコンソールで使えるプロファイルの新しいリリースを作成して有効化する必要があります",
      "repositoryRequired": "このエージェントのリリースで使えるリポジトリがないか(リポジトリが選ばれていない、カタログから外れている、またはプロファイルやワークスペースの上限が許可していません)、エージェントのGitHub設定を読み取れないため、開始できませんでした。エージェントの管理者がWebコンソールでGitHub設定を確認し、リポジトリが必要なら選んで、新しいリリースを作成して有効化する必要があります"
    },
    "ko": {
      "connect": "웹에서 Slack 계정을 연결해 주세요",
      "credentialUnbound": "연결 설정이 바뀌어 시작하지 못했어요. 에이전트 관리자에게 문의하세요",
      "failed": "지금은 요청을 처리하지 못했어요. 잠시 뒤 다시 시도해 주세요",
      "guestDisabled": "이 워크스페이스는 게스트의 에이전트 사용을 허용하지 않아요",
      "membersOnly": "이 에이전트는 이 워크스페이스 구성원만 쓸 수 있어요",
      "noActiveRelease": "이 에이전트는 아직 활성화된 릴리스가 없어요. 에이전트 관리자가 웹 콘솔에서 릴리스를 활성화해야 해요",
      "noApproveRight": "이 요청을 승인할 권한이 없어요",
      "noRequestRight": "이 채널에서 이 에이전트에게 요청할 권한이 없어요",
      "outOfShare": "이 세션은 공유 범위 밖이라 요청할 수 없어요. 세션을 시작한 사람에게 공유를 요청하세요",
      "pendingApproval": "이 채널은 관리자 승인을 기다리고 있어요",
      "profileUnavailable": "이 에이전트의 릴리스가 쓰는 프로필이 지금 카탈로그에 없거나, 바뀌었거나, 운영자가 차단해 시작하지 못했어요. 에이전트 관리자가 웹 콘솔에서 쓸 수 있는 프로필로 새 릴리스를 만들고 활성화해야 해요",
      "repositoryRequired": "이 에이전트의 릴리스에 쓸 수 있는 저장소가 없거나(저장소를 고르지 않았거나, 카탈로그에서 빠졌거나, 프로필·워크스페이스 상한이 허용하지 않아요) 에이전트의 GitHub 설정을 읽을 수 없어 시작하지 못했어요. 에이전트 관리자가 웹 콘솔에서 GitHub 설정을 확인하고, 저장소가 필요하면 골라 새 릴리스를 만들고 활성화해야 해요"
    }
  },
